<?xml version="1.0" encoding="utf-8" ?>
<xcal:icalendar xmlns:xcal="urn:ietf:params:xml:ns:icalendar-2.0">
  <xcal:vcalendar>
    <xcal:properties>
      <xcal:prodid>
        <xcal:text>-//Example Corp.//Example Client//EN</xcal:text>
      </xcal:prodid>
      <xcal:version>
        <xcal:text>2.0</xcal:text>
      </xcal:version>
    </xcal:properties>
    <xcal:components>
      <xcal:vtimezone>
        <xcal:properties>
          <xcal:last-modified>
            <xcal:date-time>2004-01-10T03:28:45Z</xcal:date-time>
          </xcal:last-modified>
          <xcal:tzid><xcal:text>US/Eastern</xcal:text></xcal:tzid>
        </xcal:properties>
        <xcal:components>
          <xcal:daylight>
            <xcal:properties>
              <xcal:dtstart>
                <xcal:date-time>2000-04-04T02:00:00</xcal:date-time>
              </xcal:dtstart>
              <xcal:rrule>
                <xcal:recur>
                  <xcal:freq>YEARLY</xcal:freq>
                  <xcal:byday>1SU</xcal:byday>
                  <xcal:bymonth>4</xcal:bymonth>
                </xcal:recur>
              </xcal:rrule>
              <xcal:tzname>
                <xcal:text>EDT</xcal:text>
              </xcal:tzname>
              <xcal:tzoffsetfrom>
                <xcal:utc-offset>-05:00</xcal:utc-offset>
              </xcal:tzoffsetfrom>
              <xcal:tzoffsetto>
                <xcal:utc-offset>-04:00</xcal:utc-offset>
              </xcal:tzoffsetto>
            </xcal:properties>
          </xcal:daylight>
          <xcal:standard>
            <xcal:properties>
              <xcal:dtstart>
                <xcal:date-time>2000-10-26T02:00:00</xcal:date-time>
              </xcal:dtstart>
              <xcal:rrule>
                <xcal:recur>
                  <xcal:freq>YEARLY</xcal:freq>
                  <xcal:byday>-1SU</xcal:byday>
                  <xcal:bymonth>10</xcal:bymonth>
                </xcal:recur>
              </xcal:rrule>
              <xcal:tzname>
                <xcal:text>EST</xcal:text>
              </xcal:tzname>
              <xcal:tzoffsetfrom>
                <xcal:utc-offset>-04:00</xcal:utc-offset>
              </xcal:tzoffsetfrom>
              <xcal:tzoffsetto>
                <xcal:utc-offset>-05:00</xcal:utc-offset>
              </xcal:tzoffsetto>
            </xcal:properties>
          </xcal:standard>
        </xcal:components>
      </xcal:vtimezone>
      <xcal:vevent>
        <xcal:properties>
          <xcal:description>
            <xcal:text>We are having a meeting all this week at 12 pm for one hour, with an additional meeting on the first day 2 hours long.&#x0a;Please bring your own lunch for the 12 pm meetings.</xcal:text>
          </xcal:description>
          <xcal:dtstamp>
            <xcal:date-time>2006-02-06T00:11:21Z</xcal:date-time>
          </xcal:dtstamp>
          <xcal:dtstart>
            <xcal:parameters>
              <xcal:tzid><xcal:text>US/Eastern</xcal:text></xcal:tzid>
            </xcal:parameters>
            <xcal:date-time>2006-01-02T12:00:00</xcal:date-time>
          </xcal:dtstart>
          <xcal:duration>
            <xcal:duration>PT1H</xcal:duration>
          </xcal:duration>
          <xcal:rdate>
            <xcal:parameters>
              <xcal:tzid><xcal:text>US/Eastern</xcal:text></xcal:tzid>
            </xcal:parameters>
            <xcal:period>
              <xcal:start>2006-01-02T15:00:00</xcal:start>
              <xcal:duration>PT2H</xcal:duration>
            </xcal:period>
          </xcal:rdate>
          <xcal:rrule>
            <xcal:recur>
              <xcal:freq>DAILY</xcal:freq>
              <xcal:count>5</xcal:count>
            </xcal:recur>
          </xcal:rrule>
          <xcal:summary>
            <xcal:text>Event #2</xcal:text>
          </xcal:summary>
          <xcal:uid>
            <xcal:text>00959BC664CA650E933C892C@example.com</xcal:text>
          </xcal:uid>
        </xcal:properties>
      </xcal:vevent>
      <xcal:vevent>
        <xcal:properties>
          <xcal:dtstamp>
            <xcal:date-time>2006-02-06T00:11:21Z</xcal:date-time>
          </xcal:dtstamp>
          <xcal:dtstart>
            <xcal:parameters>
              <xcal:tzid><xcal:text>US/Eastern</xcal:text></xcal:tzid>
            </xcal:parameters>
            <xcal:date-time>2006-01-04T14:00:00</xcal:date-time>
          </xcal:dtstart>
          <xcal:duration>
            <xcal:duration>PT1H</xcal:duration>
          </xcal:duration>
          <xcal:recurrence-id>
            <xcal:parameters>
              <xcal:tzid><xcal:text>US/Eastern</xcal:text></xcal:tzid>
            </xcal:parameters>
            <xcal:date-time>2006-01-04T12:00:00</xcal:date-time>
          </xcal:recurrence-id>
          <xcal:summary>
            <xcal:text>Event #2 bis</xcal:text>
          </xcal:summary>
          <xcal:uid>
            <xcal:text>00959BC664CA650E933C892C@example.com</xcal:text>
          </xcal:uid>
        </xcal:properties>
      </xcal:vevent>
    </xcal:components>
  </xcal:vcalendar>
</xcal:icalendar>
