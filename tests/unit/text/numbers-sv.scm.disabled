;;; Examples borrowed from
;;; https://www.tuomas.salste.net/doc/numero/numerals.html?sv
;;; Some changes have been made, including adding "ett" to the
;;; start of some words.

(define-module (test text-numbers-sv)
  :use-module (srfi srfi-64)
  :use-module (srfi srfi-71)
  :use-module (srfi srfi-88)
  :use-module (text numbers))

;;; Kardinaltal – Cardinal numbers

(test-group "Cardinal numbers"
  (test-equal "minus två"                     (number->string-cardinal -2 language: 'sv))
  (test-equal "minus ett"                     (number->string-cardinal -1 language: 'sv))
  (test-equal "noll"                          (number->string-cardinal 0 language: 'sv))
  (test-equal "ett"                           (number->string-cardinal 1 language: 'sv))
  (test-equal "två"                           (number->string-cardinal 2 language: 'sv))
  (test-equal "tre"                           (number->string-cardinal 3 language: 'sv))
  (test-equal "fyra"                          (number->string-cardinal 4 language: 'sv))
  (test-equal "fem"                           (number->string-cardinal 5 language: 'sv))
  (test-equal "sex"                           (number->string-cardinal 6 language: 'sv))
  (test-equal "sju"                           (number->string-cardinal 7 language: 'sv))
  (test-equal "åtta"                          (number->string-cardinal 8 language: 'sv))
  (test-equal "nio"                           (number->string-cardinal 9 language: 'sv))
  (test-equal "tio"                           (number->string-cardinal 10 language: 'sv))
  (test-equal "elva"                          (number->string-cardinal 11 language: 'sv))
  (test-equal "tolv"                          (number->string-cardinal 12 language: 'sv))
